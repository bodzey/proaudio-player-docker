#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

base=(docker compose -f compose.yaml)
hardware=(docker compose -f compose.yaml -f compose.hardware.yaml)
SERVICE=proaudio-player
NATIVE=sources/proaudio-player-native
WEBUI=sources/proaudio-player-webui
OUTPUT_ENV=docker-data/data/audio-output.env

require_sources() {
    if [[ ! -f "$NATIVE/Cargo.toml" || ! -f "$WEBUI/index.html" ]]; then
        echo "Dev submodules не ініціалізовано." >&2
        echo "Виконайте: git submodule update --init sources/proaudio-player-native sources/proaudio-player-webui" >&2
        exit 1
    fi
}

initialize() {
    require_sources
    install -d -m 0755 docker-data/config docker-data/data docker-data/music

    if [[ ! -f docker-data/config/config.yaml ]]; then
        install -m 0644 "$NATIVE/config/config.yaml.example" \
            docker-data/config/config.yaml
    fi
    if [[ ! -f docker-data/config/audio.env ]]; then
        install -m 0644 "$NATIVE/config/audio.env.example" \
            docker-data/config/audio.env
    fi
    for config_name in mpd.conf shairport-sync.conf spotifyd.conf; do
        if [[ ! -f "docker-data/config/$config_name" ]]; then
            install -m 0644 "$NATIVE/config/$config_name" \
                "docker-data/config/$config_name"
        fi
    done
    if [[ ! -f docker-data/config/alerts-token ]]; then
        install -m 0600 /dev/null docker-data/config/alerts-token
    fi

    echo "Docker runtime ініціалізовано."
}

sync_dev() {
    git submodule sync --recursive
    git submodule update --init --remote sources/proaudio-player-native sources/proaudio-player-webui
    echo "Оновлено submodules до поточних dev-гілок:"
    revisions
}

revisions() {
    require_sources
    printf 'native  %s  (%s)\n' \
        "$(git -C "$NATIVE" rev-parse --short=12 HEAD)" \
        "$(git -C "$NATIVE" branch --show-current || true)"
    printf 'webui   %s  (%s)\n' \
        "$(git -C "$WEBUI" rev-parse --short=12 HEAD)" \
        "$(git -C "$WEBUI" branch --show-current || true)"
}

saved_sink() {
    sed -n 's/^PHYSICAL_SINK=//p' "$OUTPUT_ENV" 2>/dev/null | tail -n 1
}

save_sink() {
    local sink="$1"
    if ! [[ "$sink" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
        echo "Некоректна назва PipeWire sink: $sink" >&2
        exit 1
    fi
    install -d -m 0755 "$(dirname "$OUTPUT_ENV")"
    printf 'PHYSICAL_SINK=%s\n' "$sink" >"$OUTPUT_ENV"
}

select_audio() {
    [[ -d /dev/snd ]] || {
        echo "На хості немає /dev/snd; звуковий пристрій не виявлено." >&2
        exit 1
    }
    initialize
    echo "Збирання amd64 образу та пошук аудіовиходів..."
    "${hardware[@]}" build

    local discovery_output
    if ! discovery_output="$("${hardware[@]}" run -T --rm --no-deps \
        --entrypoint /usr/local/bin/discover-audio.sh "$SERVICE")"; then
        echo "Не вдалося отримати список аудіовиходів." >&2
        exit 1
    fi

    local -a sink_names=() sink_descriptions=()
    while IFS=$'\t' read -r marker sink description; do
        [[ "$marker" == "SINK" && -n "$sink" ]] || continue
        sink_names+=("$sink")
        sink_descriptions+=("$description")
    done <<<"$discovery_output"

    if ((${#sink_names[@]} == 0)); then
        echo "Фізичних аудіовиходів не знайдено." >&2
        exit 1
    fi

    local current default_choice=1
    current="$(saved_sink)"
    echo
    echo "Доступні аудіовиходи:"
    for index in "${!sink_names[@]}"; do
        local number=$((index + 1)) suffix=""
        if [[ "${sink_names[$index]}" == "$current" ]]; then
            suffix=" (поточний)"
            default_choice="$number"
        fi
        printf '  %d) %s%s\n     %s\n' "$number" \
            "${sink_descriptions[$index]}" "$suffix" "${sink_names[$index]}"
    done

    if [[ ! -t 0 ]]; then
        echo "Потрібен інтерактивний термінал для вибору аудіовиходу." >&2
        exit 1
    fi

    local choice
    read -r -p "Оберіть номер аудіовиходу [$default_choice]: " choice
    choice="${choice:-$default_choice}"
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#sink_names[@]})); then
        echo "Неправильний номер аудіовиходу." >&2
        exit 1
    fi

    save_sink "${sink_names[$((choice - 1))]}"
    echo "Вибрано: ${sink_descriptions[$((choice - 1))]}"
}

compose_with_revisions() {
    require_sources
    NATIVE_REVISION="$(git -C "$NATIVE" rev-parse HEAD)" \
    WEBUI_REVISION="$(git -C "$WEBUI" rev-parse HEAD)" \
    "$@"
}

case "${1:-}" in
    init)
        initialize
        ;;
    sync-dev)
        sync_dev
        ;;
    revisions|core-rev)
        revisions
        ;;
    up-test)
        initialize
        compose_with_revisions "${base[@]}" up -d --build
        ;;
    up-hardware)
        [[ -d /dev/snd ]] || {
            echo "На хості немає /dev/snd; використайте up-test або підключіть аудіопристрій." >&2
            exit 1
        }
        initialize
        current="$(saved_sink)"
        if [[ -n "$current" ]]; then
            echo "Збережений аудіовихід: $current"
        else
            echo "Аудіовихід не зафіксовано; PipeWire автоматично вибере фізичний sink."
        fi
        compose_with_revisions "${hardware[@]}" up -d --build
        ;;
    select-audio)
        select_audio
        ;;
    down)
        "${base[@]}" down
        ;;
    status)
        "${base[@]}" ps
        "${base[@]}" exec "$SERVICE" supervisorctl \
            -c /etc/supervisor/conf.d/proaudio-player.conf status
        ;;
    logs)
        "${base[@]}" logs -f --tail "${2:-150}" "$SERVICE"
        ;;
    sinks)
        "${base[@]}" exec -u proaudio-player "$SERVICE" pactl list short sinks
        ;;
    state)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml status
        ;;
    test-cycle)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml \
            test-cycle --hold "${2:-5}"
        ;;
    test-silence)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml test-silence
        ;;
    mpd-update)
        "${base[@]}" exec "$SERVICE" mpc update
        ;;
    mpc)
        shift
        "${base[@]}" exec "$SERVICE" mpc "$@"
        ;;
    shell)
        "${base[@]}" exec "$SERVICE" bash
        ;;
    *)
        echo "Використання: docker/proaudio-player-dockerctl {init|sync-dev|revisions|select-audio|up-test|up-hardware|down|status|logs [рядки]|sinks|state|test-cycle [секунди]|test-silence|mpd-update|mpc [команда]|shell}" >&2
        exit 2
        ;;
esac
