#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$PROJECT_ROOT"

base=(docker compose -f compose.yaml)
hardware=(docker compose -f compose.yaml -f compose.hardware.yaml)
SERVICE=proaudio-player
NATIVE=sources/proaudio-player-native
WEBUI=sources/proaudio-player-webui
OUTPUT_ENV=docker-data/data/audio-output.env

require_sources() {
    if [[ ! -f "$NATIVE/Cargo.toml" \
        || ! -f "$WEBUI/package.json" \
        || ! -f "$WEBUI/package-lock.json" ]]; then
        echo "Source submodules не ініціалізовано." >&2
        echo "Виконайте: git submodule update --init sources/proaudio-player-native sources/proaudio-player-webui" >&2
        exit 1
    fi
}

initialize() {
    require_sources
    install -d -m 0755 docker-data/config docker-data/data docker-data/music

    if [[ ! -f docker-data/config/config.yaml ]]; then
        install -m 0644 "$NATIVE/config/config.yaml.example" \
            docker-data/config/config.yaml
    fi
    if [[ ! -f docker-data/config/audio.env.override ]]; then
        install -m 0644 /dev/null docker-data/config/audio.env.override
    fi
    if [[ ! -f docker-data/config/alerts-token ]]; then
        install -m 0600 /dev/null docker-data/config/alerts-token
    fi

    echo "Docker runtime ініціалізовано."
}

configured_branch() {
    local module="$1"
    git config -f .gitmodules --get "submodule.${module}.branch" 2>/dev/null || printf '%s' '<pinned>'
}

sync_sources() {
    git submodule sync --recursive
    git submodule update --init sources/proaudio-player-native sources/proaudio-player-webui
    git submodule update --remote --checkout sources/proaudio-player-native sources/proaudio-player-webui
    echo "Оновлено source checkout-и до гілок, заданих у .gitmodules:"
    revisions
    echo "Gitlink-и Docker-репозиторію є лише bootstrap snapshot; для dev їх оновлювати commit-ом не потрібно."
}

revisions() {
    require_sources
    printf 'native  %s  (%s)\n' \
        "$(git -C "$NATIVE" rev-parse --short=12 HEAD)" \
        "$(configured_branch sources/proaudio-player-native)"
    printf 'webui   %s  (%s)\n' \
        "$(git -C "$WEBUI" rev-parse --short=12 HEAD)" \
        "$(configured_branch sources/proaudio-player-webui)"
}

saved_sink() {
    [[ -f "$OUTPUT_ENV" ]] || return 0
    sed -n 's/^PHYSICAL_SINK=//p' "$OUTPUT_ENV" | tail -n 1
}

save_sink() {
    local sink="$1"
    if ! [[ "$sink" =~ ^[A-Za-z0-9_.:-]+$ ]]; then
        echo "Некоректна назва PipeWire sink: $sink" >&2
        exit 1
    fi
    install -d -m 0755 "$(dirname "$OUTPUT_ENV")"
    printf 'PHYSICAL_SINK=%s\n' "$sink" >"$OUTPUT_ENV"
}

select_audio() {
    [[ -d /dev/snd ]] || {
        echo "На хості немає /dev/snd; звуковий пристрій не виявлено." >&2
        exit 1
    }
    initialize
    echo "Збирання runtime для архітектури хоста та пошук аудіовиходів..."
    compose_with_revisions "${hardware[@]}" build "$SERVICE"

    local discovery_output
    if ! discovery_output="$("${hardware[@]}" run -T --rm --no-deps \
        --entrypoint /usr/local/bin/discover-audio.sh "$SERVICE")"; then
        echo "Не вдалося отримати список аудіовиходів." >&2
        exit 1
    fi

    local -a sink_names=() sink_descriptions=()
    while IFS=$'\t' read -r marker sink description; do
        [[ "$marker" == "SINK" && -n "$sink" ]] || continue
        sink_names+=("$sink")
        sink_descriptions+=("$description")
    done <<<"$discovery_output"

    if ((${#sink_names[@]} == 0)); then
        echo "Фізичних аудіовиходів не знайдено." >&2
        exit 1
    fi

    local current default_choice=1
    current="$(saved_sink)"
    echo
    echo "Доступні аудіовиходи:"
    for index in "${!sink_names[@]}"; do
        local number=$((index + 1)) suffix=""
        if [[ "${sink_names[$index]}" == "$current" ]]; then
            suffix=" (поточний)"
            default_choice="$number"
        fi
        printf '  %d) %s%s\n     %s\n' "$number" \
            "${sink_descriptions[$index]}" "$suffix" "${sink_names[$index]}"
    done

    if [[ ! -t 0 ]]; then
        echo "Потрібен інтерактивний термінал для вибору аудіовиходу." >&2
        exit 1
    fi

    local choice
    read -r -p "Оберіть номер аудіовиходу [$default_choice]: " choice
    choice="${choice:-$default_choice}"
    if ! [[ "$choice" =~ ^[0-9]+$ ]] || ((choice < 1 || choice > ${#sink_names[@]})); then
        echo "Неправильний номер аудіовиходу." >&2
        exit 1
    fi

    save_sink "${sink_names[$((choice - 1))]}"
    echo "Вибрано: ${sink_descriptions[$((choice - 1))]}"
}

compose_with_revisions() {
    require_sources
    APP_VERSION="${APP_VERSION:-$(git branch --show-current 2>/dev/null || printf '%s' docker)}" \
    NATIVE_REVISION="$(git -C "$NATIVE" rev-parse HEAD)" \
    WEBUI_REVISION="$(git -C "$WEBUI" rev-parse HEAD)" \
    "$@"
}

case "${1:-}" in
    init)
        initialize
        ;;
    sync-sources|sync-dev)
        sync_sources
        ;;
    revisions|core-rev)
        revisions
        ;;
    build)
        initialize
        compose_with_revisions "${base[@]}" build
        ;;
    up-test)
        initialize
        compose_with_revisions "${base[@]}" up -d --build --remove-orphans
        ;;
    up-hardware)
        [[ -d /dev/snd ]] || {
            echo "На хості немає /dev/snd; використайте up-test або підключіть аудіопристрій." >&2
            exit 1
        }
        initialize
        current="$(saved_sink)"
        if [[ -n "$current" ]]; then
            echo "Збережений аудіовихід: $current"
        else
            echo "Аудіовихід не зафіксовано; native output policy вибере доступний фізичний sink."
        fi
        compose_with_revisions "${hardware[@]}" up -d --build --remove-orphans
        ;;
    select-audio)
        select_audio
        ;;
    down)
        "${base[@]}" down --remove-orphans
        ;;
    status)
        "${base[@]}" ps
        "${base[@]}" exec "$SERVICE" bash -lc '
            for service in /etc/proaudio-player/services/*; do
                printf "%-20s " "$(basename "$service")"
                s6-svstat "$service"
            done
        '
        ;;
    logs)
        "${base[@]}" logs -f --tail "${2:-150}"
        ;;
    mdns)
        discovery_interface="$("${base[@]}" exec -T "$SERVICE" awk -F= '
            /^allow-interfaces=/ { print $2; exit }
        ' /etc/avahi/avahi-daemon.conf)"

        echo "Host UDP/5353 sockets:"
        socket_output="$(ss -H -lunp 'sport = :5353' 2>/dev/null || true)"
        if [[ -n "$socket_output" ]]; then
            printf '%s\n' "$socket_output"
        else
            ss -H -lun 'sport = :5353' 2>/dev/null || true
        fi

        echo
        echo "Host mDNS services:"
        if command -v systemctl >/dev/null 2>&1; then
            for unit in systemd-resolved avahi-daemon; do
                state="$(systemctl is-active "$unit" 2>/dev/null || true)"
                [[ -n "$state" ]] || state=unknown
                printf '  %-18s %s\n' "$unit" "$state"
            done
        else
            echo "  systemctl unavailable"
        fi

        if [[ -n "$discovery_interface" ]] && command -v resolvectl >/dev/null 2>&1; then
            echo
            echo "systemd-resolved link state ($discovery_interface):"
            resolvectl status "$discovery_interface" 2>/dev/null |
                grep -E '^[[:space:]]*(Protocols:|Current Scopes:)' || true
        fi

        echo
        echo "UDP/5353 sockets present before container services started:"
        "${base[@]}" exec -T "$SERVICE" sh -lc '
            if [[ -s /run/proaudio-player/external-mdns-sockets ]]; then
                cat /run/proaudio-player/external-mdns-sockets
            else
                echo "<none>"
            fi
        '

        echo
        echo "Container startup diagnostic:"
        if "${base[@]}" exec -T "$SERVICE" test -e /run/proaudio-player/external-mdns-stack; then
            echo "external mDNS responder was present before container services started"
            if [[ "$socket_output" != *"users:(("* ]]; then
                echo "socket owners are hidden; run: sudo ss -H -lunp 'sport = :5353'"
            fi
        else
            echo "no external mDNS responder was detected before container services started"
        fi

        echo
        printf 'Avahi allow-interfaces=%s\n' "$discovery_interface"
        ;;
    sinks)
        "${base[@]}" exec -u proaudio-player "$SERVICE" pactl list short sinks
        ;;
    state)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml status
        ;;
    test-cycle)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml \
            test-cycle --hold "${2:-5}"
        ;;
    test-silence)
        "${base[@]}" exec -u proaudio-player "$SERVICE" \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml test-silence
        ;;
    mpd-update)
        "${base[@]}" exec "$SERVICE" mpc update
        ;;
    mpc)
        shift
        "${base[@]}" exec "$SERVICE" mpc "$@"
        ;;
    shell)
        "${base[@]}" exec "$SERVICE" bash
        ;;
    *)
        echo "Використання: docker/proaudio-player-dockerctl {init|sync-sources|revisions|build|select-audio|up-test|up-hardware|down|status|logs [рядки]|mdns|sinks|state|test-cycle [секунди]|test-silence|mpd-update|mpc [команда]|shell}" >&2
        exit 2
        ;;
esac
