#!/usr/bin/env bash
set -euo pipefail

service_name="$(basename "$PWD")"

wait_for_system_bus() {
    local attempt
    for ((attempt = 0; attempt < 100; attempt++)); do
        if [[ -S /run/dbus/system_bus_socket ]] \
            && busctl --system --no-pager list >/dev/null 2>&1; then
            return 0
        fi
        sleep 0.1
    done
    echo "System D-Bus не став доступним протягом 10 секунд" >&2
    return 1
}

wait_for_avahi() {
    local attempt
    for ((attempt = 0; attempt < 100; attempt++)); do
        if busctl --system --no-pager list 2>/dev/null |
            awk '$1 == "org.freedesktop.Avahi" { found=1 } END { exit !found }'; then
            return 0
        fi
        sleep 0.1
    done
    echo "Avahi D-Bus service не став доступним протягом 10 секунд" >&2
    return 1
}

wait_for_pipewire() {
    local socket="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}/pipewire-0"
    local attempt
    for ((attempt = 0; attempt < 100; attempt++)); do
        [[ -S "$socket" ]] && return 0
        sleep 0.1
    done
    echo "PipeWire core socket не з'явився протягом 10 секунд" >&2
    return 1
}

run_as_player() {
    exec /usr/bin/setpriv \
        --reuid=proaudio-player \
        --regid=proaudio-player \
        --init-groups \
        -- "$@"
}

run_as_realtime_player() {
    if [[ "${AUDIO_MODE:-null}" != "hardware" ]]; then
        run_as_player "$@"
    fi

    exec /usr/bin/setpriv \
        --reuid=proaudio-player \
        --regid=proaudio-player \
        --init-groups \
        --inh-caps=+sys_nice \
        --ambient-caps=+sys_nice \
        -- "$@"
}

case "$service_name" in
    system-dbus)
        exec /usr/bin/dbus-daemon --system --nofork --nopidfile
        ;;
    session-dbus)
        run_as_player /usr/bin/dbus-daemon \
            --session \
            --nofork \
            --nopidfile \
            --address=unix:path=/run/proaudio-player/session-bus
        ;;
    pipewire)
        run_as_realtime_player /usr/bin/pipewire
        ;;
    pipewire-pulse)
        wait_for_pipewire
        run_as_realtime_player /usr/bin/pipewire-pulse
        ;;
    wireplumber)
        wait_for_pipewire
        run_as_realtime_player /usr/bin/wireplumber --profile main-systemwide
        ;;
    audio-buses)
        run_as_player /usr/local/bin/run-audio-buses.sh
        ;;
    audio-output-watch)
        export AUDIO_ENV=/run/proaudio-player/audio.env
        export OUTPUT_ENV=/var/lib/proaudio-player-alert/audio-output.env
        export BUS_SCRIPT=/usr/libexec/proaudio-player/audio-buses.sh
        run_as_player /usr/local/bin/run-output-watch.sh
        ;;
    avahi)
        wait_for_system_bus
        exec /usr/sbin/avahi-daemon --no-chroot --no-drop-root
        ;;
    mpd)
        export PULSE_SINK=proaudio_player_music
        run_as_player /usr/local/bin/run-service.sh \
            ENABLE_MPD audio \
            /usr/bin/mpd --no-daemon /opt/proaudio-player/defaults/mpd.conf
        ;;
    airplay)
        wait_for_system_bus
        wait_for_avahi
        export PULSE_SINK=proaudio_player_music
        run_as_player /usr/local/bin/run-service.sh \
            ENABLE_AIRPLAY audio \
            /usr/bin/shairport-sync -c /opt/proaudio-player/defaults/shairport-sync.conf
        ;;
    dlna)
        export PULSE_SINK=proaudio_player_music
        run_as_player /usr/local/bin/run-service.sh \
            ENABLE_DLNA audio \
            /usr/local/bin/run-dlna.sh
        ;;
    spotify)
        wait_for_system_bus
        wait_for_avahi
        export PULSE_SINK=proaudio_player_music
        run_as_player /usr/local/bin/run-service.sh \
            ENABLE_SPOTIFY audio \
            /usr/local/bin/spotifyd \
            --no-daemon \
            --config-path /opt/proaudio-player/defaults/spotifyd.conf
        ;;
    native)
        wait_for_system_bus
        export PROAUDIO_AUDIO_ENV=/run/proaudio-player/audio.env
        run_as_player /usr/local/bin/run-service.sh \
            ALWAYS audio \
            /usr/local/bin/proaudio-player-native \
            --config /etc/proaudio-player-alert/config.yaml run
        ;;
    *)
        echo "Невідома s6-служба: $service_name" >&2
        exit 64
        ;;
esac
